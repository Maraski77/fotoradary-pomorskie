<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<title>Mapa fotoradarów – Pomorskie</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

<style>
  body { margin:0; font-family:Arial; }
  #map { height:100vh; width:100vw; }

  .panel {
    position:absolute; top:10px; left:10px;
    background:#fff; padding:10px; border-radius:6px;
    box-shadow:0 2px 6px rgba(0,0,0,0.2);
    z-index:1000; width:260px; max-height:90vh; overflow-y:auto;
  }

  button {
    width:100%; padding:8px; margin-top:10px;
    background:orange; border:none; color:#fff;
    font-weight:bold; cursor:pointer; border-radius:4px;
  }

  #pieChart { display:block; margin:8px auto; }
</style>
</head>

<body>

<div id="map"></div>

<div class="panel">
  <h3>Fotoradary – Pomorskie</h3>

  <label><input type="checkbox" id="stacjonarne" checked> Stacjonarne</label><br>
  <label><input type="checkbox" id="opp" checked> OPP</label><br>
  <label><input type="checkbox" id="redlight" checked> Red-light</label><br>
  <label><input type="checkbox" id="heat" checked> Heatmap</label><br>

  <input id="search" type="text" placeholder="Szukaj (np. Gdańsk)">
  <div id="results"></div>

  <h4>Statystyki</h4>
  <div id="stats"></div>

  <h4>Wykres kołowy</h4>
  <canvas id="pieChart" width="240" height="240"></canvas>
  <div id="pieLegend"></div>

  <button id="startOPP">Start OPP</button>
</div>

<script>
let radars = [];
let oppPairs = [];
let map;

// Wczytanie danych
fetch("radars.json")
  .then(r => r.json())
  .then(data => { radars = data; init(); });

// Animacja OPP — styl D (gradient + pulsowanie)
function animateOPP(start, end) {

  // Podświetlenie trasy
  const glowLine = L.polyline([[start.lat, start.lon], [end.lat, end.lon]], {
    color: "orange",
    weight: 6,
    opacity: 0.8
  }).addTo(map);

  let pulse = 0;
  const pulseInterval = setInterval(() => {
    pulse += 0.1;
    glowLine.setStyle({
      opacity: 0.5 + Math.sin(pulse) * 0.4
    });
  }, 50);

  // Animacja markera
  const duration = 3000;
  const steps = 200;

  const latStep = (end.lat - start.lat) / steps;
  const lonStep = (end.lon - start.lon) / steps;

  const marker = L.circleMarker([start.lat, start.lon], {
    radius: 8,
    color: "orange",
    fillColor: "yellow",
    fillOpacity: 1
  }).addTo(map);

  let i = 0;
  const interval = setInterval(() => {
    marker.setLatLng([start.lat + latStep * i, start.lon + lonStep * i]);
    i++;

    if (i >= steps) {
      clearInterval(interval);
      clearInterval(pulseInterval);
      setTimeout(() => {
        map.removeLayer(marker);
        map.removeLayer(glowLine);
      }, 500);
    }
  }, duration / steps);
}

// Wykres kołowy
function drawPieChart(stats) {
  const canvas = document.getElementById("pieChart");
  const ctx = canvas.getContext("2d");
  const data = [
    { label: "Stacjonarne", value: stats.stacjonarne, color: "red" },
    { label: "OPP", value: stats.opp, color: "blue" },
    { label: "Red-light", value: stats.redlight, color: "green" }
  ];
  const total = data.reduce((s, d) => s + d.value, 0);
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  let startAngle = 0;

  data.forEach(d => {
    const slice = (d.value / total) * 2 * Math.PI;
    ctx.beginPath();
    ctx.moveTo(120, 120);
    ctx.arc(120, 120, 100, startAngle, startAngle + slice);
    ctx.closePath();
    ctx.fillStyle = d.color;
    ctx.fill();
    startAngle += slice;
  });

  document.getElementById("pieLegend").innerHTML =
    data.map(d => `<div><span style="display:inline-block;width:12px;height:12px;background:${d.color};margin-right:6px;"></span>${d.label}: ${d.value}</div>`).join("");
}

// Statystyki
function updateStats() {
  const stats = {
    all: radars.length,
    stacjonarne: radars.filter(r => r.type === "stacjonarny").length,
    opp: radars.filter(r => r.type === "opp_start" || r.type === "opp_end").length,
    redlight: radars.filter(r => r.type === "redlight").length
  };
  document.getElementById("stats").innerHTML = `
    Wszystkie: ${stats.all}<br>
    Stacjonarne: ${stats.stacjonarne}<br>
    OPP: ${stats.opp}<br>
    Red-light: ${stats.redlight}
  `;
  drawPieChart(stats);
}

// Inicjalizacja mapy
function init() {
  map = L.map("map").setView([54.2, 18.6], 8);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19 }).addTo(map);

  const layerS = L.layerGroup().addTo(map);
  const layerO = L.layerGroup().addTo(map);
  const layerR = L.layerGroup().addTo(map);

  const heat = L.heatLayer(radars.map(r => [r.lat, r.lon, 0.8]), {
    radius: 25, blur: 15
  }).addTo(map);

  const icons = {
    stacjonarny: L.icon({
      iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png",
      shadowUrl: "https://unpkg.com/leaflet/dist/images/marker-shadow.png",
      iconSize: [25, 41], iconAnchor: [12, 41]
    }),
    opp_start: L.icon({
      iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-blue.png",
      shadowUrl: "https://unpkg.com/leaflet/dist/images/marker-shadow.png",
      iconSize: [25, 41], iconAnchor: [12, 41]
    }),
    opp_end: L.icon({
      iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-blue.png",
      shadowUrl: "https://unpkg.com/leaflet/dist/images/marker-shadow.png",
      iconSize: [25, 41], iconAnchor: [12, 41]
    }),
    redlight: L.icon({
      iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png",
      shadowUrl: "https://unpkg.com/leaflet/dist/images/marker-shadow.png",
      iconSize: [25, 41], iconAnchor: [12, 41]
    })
  };

  const markers = [];

  radars.forEach(r => {
    const marker = L.marker([r.lat, r.lon], { icon: icons[r.type] })
      .bindPopup(`<b>${r.name}</b><br>${r.town}<br>${r.type}<br>${r.note || ""}`);

    if (r.type === "stacjonarny") marker.addTo(layerS);
    if (r.type === "opp_start" || r.type === "opp_end") marker.addTo(layerO);
    if (r.type === "redlight") marker.addTo(layerR);

    markers.push({ radar: r, marker });
  });

  // Parowanie OPP
  const starts = radars.filter(r => r.type === "opp_start");
  const ends = radars.filter(r => r.type === "opp_end");

  starts.forEach(start => {
    const end = ends.find(e => e.name === start.name);
    if (end) oppPairs.push({ start, end });
  });

  // Przycisk Start OPP
  document.getElementById("startOPP").onclick = () => {
    if (oppPairs.length > 0) {
      animateOPP(oppPairs[0].start, oppPairs[0].end);
    }
  };

  updateStats();
}
</script>

</body>
